<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Camera-host HTTP is required by the Panasonic wire protocol. Internet clients use HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.54.1</domain>
    </domain-config>
</network-security-config>
